# Ella AI Production Environment Configuration
# Copy this file to .env.production and fill in the values for your production environment

# Application Settings
NODE_ENV=production
PORT=5000

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Voice Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# SignalWire Communication Service
SIGNALWIRE_PROJECT_ID=your_signalwire_project_id
SIGNALWIRE_TOKEN=your_signalwire_token
SIGNALWIRE_SPACE_URL=your_signalwire_space_url
SIGNALWIRE_PHONE_NUMBER=your_signalwire_phone_number

# Twilio Configuration (if used)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Database Configuration
DATABASE_URL=postgres://username:password@host:port/database
PGUSER=db_username
PGPASSWORD=db_password
PGHOST=db_host
PGPORT=db_port
PGDATABASE=db_name

# Vite Frontend Environment Variables (must be prefixed with VITE_)
VITE_PUBLIC_API_URL=https://your-production-domain.com
VITE_APP_NAME=Ella AI